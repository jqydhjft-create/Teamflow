APP_NAME=TeamFlow API
APP_VERSION=0.1.0
DEBUG=false
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]
LOG_LEVEL=INFO
JWT_SECRET_KEY=REPLACE_ME_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=teamflow
MYSQL_PASSWORD=teamflow
MYSQL_DATABASE=teamflow
# Optional local fallback without Docker:
# DATABASE_URL=sqlite:///./teamflow.db

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true

REDIS_HOST=redis
REDIS_PORT=6379
